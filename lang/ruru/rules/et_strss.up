      end
    end
  end
  call lpta_loadp arg 2                 # из
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_6c62
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # изо
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_6c6285
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # без
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_6b8d62
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # для
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_836391
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # над
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_776183
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # под
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_998583
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # при
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_99646c
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # про
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_996485
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  give up
end

# English flaps a t or a d that begins an unstressed syllable -- это came out
# as эда -- and Russian never does. A secondary stress is what English does
# not flap before, so every such syllable but the first is given one.
rule ru_keep_stops takes 4 from et_strss.obj
  afresh
  local sl bytes 8
  local sr bytes 8
  local k
  local hit
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_r 7
  if answer is not 0
    give up
  end
  set k to 0
  while 1
    call savescptr 1 addr sl
    call advance_tok
    if answer is not 0
      leave
    end
    call savescptr 2 addr sr
    increment k
    set hit to 0
    if k is more than 1
      if k is not arg 3
        call lpta_loadp addr sl
        call setscan_r 2
        if answer is 0
          call testFldeq 2 0 4
          if answer is 0
            set hit to 1
          end
          call testFldeq 2 0 3
          if answer is 0
            set hit to 1
          end
          if hit is 1
            set hit to 0
            call advance_tok
            if answer is 0
              call testFldeq 2 1 1
              if answer is 0
                set hit to 1
              end
            end
          end
        end
      end
    end
    if hit is 1
      call ZZlprp_load__insert_2pt_i_7_2_ZZstring5 addr sl addr sr
    end
    call lpta_loadp addr sr
    call setscan_r 7
    if answer is not 0
      leave
    end
  end
  match
end

