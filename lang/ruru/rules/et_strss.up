  call lpta_loadp arg 2                 # до
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_8385
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # за
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_6261
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # на
  call setscan_l 1
  if answer is 0
