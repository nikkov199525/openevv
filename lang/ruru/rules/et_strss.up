# Where a Russian word is stressed, and what its unstressed vowels become.
#
# The module is US English's, and English stresses a word by its roots and
# its suffixes and then reduces what it left unstressed, none of which is
# Russian's. So a word that begins with a Russian letter comes here instead:
# ru_assign_stress stands where assign_eng_stress stood in
# eng_symbolic_rules and ru_post_syll where post_syll_adjustments stood, and
# each hands any other word on to the rule it stands for, so an English word
# in Russian text is still English.
#
# Russian stress is the word's own and no rule finds it, so this takes what
# the writing says and guesses the rest. In order:
#
#   the stress mark, the combining acute after a vowel, which a writer puts
#   where a word would be misread and a dictionary puts in every word it has;
#
#   ё, which is stressed wherever it stands, the first of them if there are
#   several;
#
#   a number word, each of which is listed whole with its syllable, since
#   the number rules write them after any dictionary has been asked;
#
#   the ending. An infinitive is stressed on the vowel before its ть and a
#   past tense on the one before its л, and -ист, -изм, -ант, -ент, -ок, -ец
#   and -ой carry the stress themselves, so those are stressed on the last
#   syllable. An adjective's ending of two vowels -- -ая, -ое, -ые, -ую --
#   and -ыми, -ого, -ому and their soft forms, and a noun's -ия and -ие,
#   leave it on the last vowel of the stem, which is two syllables before
#   the last;
#
#   and failing all of that the syllable before the last, which is the
#   commonest place.
#
# A vowel letter is a syllable in Russian, every one and nothing else, so the
# place is counted in letters and marked in syllables.
rule ru_assign_stress takes 3 from et_strss.obj
  afresh
  local left bytes 8
  local right bytes 8
  local count
  local vowels
  local target
  local togo
  local said
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_r 1
  if answer is 0
    call ru_is_russian
    if answer is not 0
      go to english
    end
  else
    go to english
  end
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  # How many syllables there are, by walking to the end of the word. The
  # scan starts outside the word, so this is one more than there are.
  call ZZlpta_load__setscan_r__7 addr left
  if answer is not 0
    give up
  end
  set count to 0
  while 1
    increment count
    call advance_tok
    if answer is not 0
      leave
    end
  end
  decrement count
  # The letters: which vowel, counted from one, the writing says.
  set vowels to 0
  set target to 0
  call lpta_loadp addr left
  call setscan_r 1
  if answer is 0
    while 1
      call ru_is_vowel
      if answer is 0
        increment vowels
        call testFldeq 1 0 143                   # ё
        if answer is 0
          if target is 0
            set target to vowels
          end
        end
      else
        call testFldeq 1 0 157                   # the stress mark
        if answer is 0
          set target to vowels
        else
          call ru_is_letter
          if answer is not 0
            leave
          end
        end
      end
      call advance_tok
      if answer is not 0
        leave
      end
    end
  end
  # A number word, and then the ending, where the writing says nothing.
  if target is 0
    call ru_word_first arg 1 arg 2
    if answer is 0
      set target to 1
    end
  end
  if target is 0
    call ru_word_second arg 1 arg 2
    if answer is 0
      set target to 2
    end
  end
  if target is 0
    call ru_word_third arg 1 arg 2
    if answer is 0
      set target to 3
    end
  end
  if target is 0
    call ru_word_last arg 1 arg 2
    if answer is 0
      set target to count
    end
  end
  if target is 0
    call ru_word_fourth arg 1 arg 2
    if answer is 0
      set target to 4
    end
  end
  if target is 0
    set target to count
    decrement target
    call ru_ends_stressed arg 2
    if answer is 0
      set target to count
    else
      call ru_ends_stem_stressed arg 2
      if answer is 0
        decrement target
      end
    end
  end
  if target is more than count
    set target to count
  end
  if target is less than 1
    set target to 1
  end
  # And the mark, over the syllable that many in: what it covers begins
  # after its left end.
  call ZZlpta_load__setscan_r__7 addr left
  if answer is not 0
    give up
  end
  set togo to target
  decrement togo
  while togo is more than 0
    call advance_tok
    decrement togo
  end
  call savescptr 1 addr left
  call advance_tok
  if answer is 0
    call savescptr 2 addr right
    call ZZlprp_load__insert_2pt_i_7_2_ZZstring3 addr left addr right
    # A word Russian never stresses has every vowel reduced: но is нъ, не ни.
    set said to target
    call ru_is_clitic arg 1 arg 2
    if answer is 0
      set said to 0
    end
    call ru_reduce arg 1 arg 2 said
    call ru_keep_stops arg 1 arg 2 target
    match
  end
  give up
place english
  call assign_eng_stress arg 1 arg 2
  if answer is 0
    match
  end
  give up
end

# What English does to a word once its syllables are stressed -- it flaps a
# t, reduces a vowel -- is English's, so a Russian word is left as
# ru_reduce left it and any other is handed on.
rule ru_post_syll takes 3 from et_strss.obj
  afresh
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_r 1
  if answer is 0
    call ru_is_russian
    if answer is 0
      match
    end
  end
  call post_syll_adjustments arg 1 arg 2
  if answer is 0
    match
  end
  give up
end

# What an unstressed vowel becomes, in the phones English has for it. An а
# or an о is H in the syllable before the stress, at the start of a word and
# after another vowel, and the schwa anywhere else: молоко is мълако. An е,
# an э and an и are I, and X, the vowel of roses, where the е follows ж or ш.
# An у is U. я is I, and the schwa where the word ends in it; it is told from
# а by the glide or the soft consonant before it.
#
# It walks the phones of the word once the stress is marked, counting the
# vowels as it goes: the stressed one is the one ru_assign_stress counted to.
rule ru_reduce takes 4 from et_strss.obj
  afresh
  local togo
  local pl bytes 8
  local pr bytes 8
  local kind
  local final
  local seen
  local before
  local pretonic
  local put
  local yl bytes 8
  local ybefore
  local soft
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_r 2
  if answer is not 0
    give up
  end
  set seen to 0
  # What the phone before this one was: 0 nothing, 1 a vowel, 2 the glide,
  # 3 ж or ш, 4 ч, 5 any other consonant.
  set before to 0
  while 1
    call savescptr 1 addr pl
    set kind to 0
    call testFldeq 2 0 44                      # а, я
    if answer is 0
      set kind to 1
    end
    call testFldeq 2 0 47                      # о
    if answer is 0
      set kind to 2
    end
    call testFldeq 2 0 31                      # е, э
    if answer is 0
      set kind to 3
    end
    call testFldeq 2 0 28                      # и
    if answer is 0
      set kind to 4
    end
    call testFldeq 2 0 45                      # у, ю
    if answer is 0
      set kind to 5
    end
    call testFldeq 2 0 33                      # ы
    if answer is 0
      set kind to 6
    end
    set put to 0
    set soft to 0
    if kind is not 0
      increment seen
      if seen is not arg 3
        set pretonic to 0
        set togo to arg 3
        decrement togo
        if seen is togo
          set pretonic to 1
        end
        if before is 0
          set pretonic to 1
        end
        if before is 1
          set pretonic to 1
        end
        if kind is 1
          set put to sym ru_ph_x
          if pretonic is 1
            set put to sym ru_ph_H
          end
          if before is 2
            set put to sym ru_ph_I
            set soft to 1
          end
          if before is 4
            set put to sym ru_ph_I
          end
        end
        if kind is 2
          set put to sym ru_ph_x
          if pretonic is 1
            set put to sym ru_ph_H
          end
        end
        if kind is 3
          set put to sym ru_ph_I
          set soft to 1
          if before is 3
            set put to sym ru_ph_X
          end
        end
        if kind is 4
          set put to sym ru_ph_I
        end
        if kind is 5
          set put to sym ru_ph_U
        end
      end
    end
    # What this phone is to the one after it.
    set togo to 5
    if kind is not 0
      set togo to 1
    end
    call testFldeq 2 0 26
    if answer is 0
      set togo to 2
      # Where the glide begins and what stood before it, for the vowel after.
      set ybefore to before
      call savescptr 3 addr yl
    end
    call testFldeq 2 0 15
    if answer is 0
      set togo to 3
    end
    call testFldeq 2 0 16
    if answer is 0
      set togo to 3
    end
    call testFldeq 2 0 18
    if answer is 0
      set togo to 4
    end
    call advance_tok
    if answer is not 0
      leave
    end
    call savescptr 2 addr pr
    set final to 0
    call lpta_loadp arg 2
    call test_ptr
    if answer is 0
      set final to 1
    end
    if put is not 0
      # я at the end of a word keeps a vowel of its own: время, неделя.
      if kind is 1
        if before is 2
          if final is 1
            set put to sym ru_ph_x
            set soft to 0
          end
        end
      end
      # The glide that softened a consonant goes where the vowel after it has
      # become I, which is soft enough by itself: тебя is тибя, not тйибя.
      if before is not 2
        set soft to 0
      end
      if ybefore is not 5
        set soft to 0
      end
      if soft is 1
        call lpta_rpta_loadp addr yl addr pr
      else
        call lpta_rpta_loadp addr pl addr pr
      end
      call insert_2pt_s 2 1 put 0
    end
    set before to togo
    if final is not 0
      leave
    end
    # Back to the phones, after this one.
    call lpta_loadp addr pr
    call setscan_r 2
    if answer is not 0
      leave
    end
  end
  match
end

# Whether the next letter is one of Russian's vowels.
rule ru_is_vowel takes 1 from et_strss.obj
  bare
  afresh
  call testFldeq 1 0 97                    # а
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 141                    # е
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 143                    # ё
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 108                    # и
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 133                    # о
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 128                    # у
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 149                    # ы
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 155                    # э
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 159                    # ю
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 145                    # я
  if answer is 0
    answer 0
  end
  answer 1
end

# Whether the next thing is a letter of any kind, rather than a space, a
# mark or nothing at all.
rule ru_is_letter takes 1 from et_strss.obj
  bare
  afresh
  call testFldeq 1 3 1
  if answer is 0
    answer 0
  end
  answer 1
end

# Whether the next letter is one of Russian's, which is how a Russian word
# is told from an English one: by its first letter.
rule ru_is_russian takes 1 from et_strss.obj
  bare
  afresh
  call testFldeq 1 0 97                    # а
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 107                    # б
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 117                    # в
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 127                    # г
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 131                    # д
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 141                    # е
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 143                    # ё
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 151                    # ж
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 98                    # з
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 108                    # и
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 118                    # й
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 132                    # к
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 99                    # л
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 109                    # м
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 119                    # н
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 133                    # о
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 153                    # п
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 100                    # р
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 110                    # с
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 120                    # т
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 128                    # у
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 134                    # ф
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 147                    # х
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 101                    # ц
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 111                    # ч
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 121                    # ш
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 135                    # щ
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 149                    # ы
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 160                    # ь
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 155                    # э
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 159                    # ю
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 145                    # я
  if answer is 0
    answer 0
  end
  answer 1
end

# Whether the word between the two points is one of the words Russian never
# stresses: the prepositions, the conjunctions и, а, но and ни, не, and the
# particles же, ли and бы. Read leftwards from its end, and then
# asked whether that was the whole of it.
rule ru_is_clitic takes 3 from et_strss.obj
  afresh
  call ZZfence_null
  call lpta_loadp arg 2                 # а
  call setscan_l 1
  if answer is 0
    call test_string_s 1 1 sym ru_end_61
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # и
  call setscan_l 1
  if answer is 0
    call test_string_s 1 1 sym ru_end_6c
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # но
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_7785
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # не
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_778d
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # ни
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_776c
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # же
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_978d
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # ли
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_636c
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # бы
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_6b95
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # во
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_7585
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # ко
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_8485
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # со
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_6e85
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # у
  call setscan_l 1
  if answer is 0
    call test_string_s 1 1 sym ru_end_80
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # о
  call setscan_l 1
  if answer is 0
    call test_string_s 1 1 sym ru_end_85
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # об
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_856b
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # обо
  call setscan_l 1
  if answer is 0
    call test_string_s 1 3 sym ru_end_856b85
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # от
  call setscan_l 1
  if answer is 0
    call test_string_s 1 2 sym ru_end_8578
