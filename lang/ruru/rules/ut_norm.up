# One digit by its name.
rule ru_digit takes 3 from ut_norm.obj
  afresh
  if arg 2 is 0
    call ru_say_778563a0 arg 1
  end
  if arg 2 is 1
    call ru_say_85836c77 arg 1
  end
  if arg 2 is 2
    call ru_say_837561 arg 1
  end
  if arg 2 is 3
    call ru_say_78646c arg 1
  end
  if arg 2 is 4
    call ru_say_6f8d7895648d arg 1
  end
  if arg 2 is 5
    call ru_say_999178a0 arg 1
  end
  if arg 2 is 6
    call ru_say_798d6e78a0 arg 1
  end
  if arg 2 is 7
    call ru_say_6e8d6da0 arg 1
  end
  if arg 2 is 8
    call ru_say_75856e8d6da0 arg 1
  end
  if arg 2 is 9
    call ru_say_838d759178a0 arg 1
  end
  match
end

# One group of three digits and the name of the group: 0 for the units, 1
# for the thousands, 2 for the millions, 3 for the thousand millions.
rule ru_group takes 6 from ut_norm.obj
  afresh
  local form
  if arg 2 is 0
    if arg 3 is 0
      if arg 4 is 0
        match
      end
    end
  end
  # The form of the group's name: 1 after one, 2 after two to four, 3 after
  # anything else and after every teen.
  set form to 3
  if arg 3 is not 1
    if arg 4 is 1
      set form to 1
    end
    if arg 4 is 2
      set form to 2
    end
    if arg 4 is 3
      set form to 2
    end
    if arg 4 is 4
      set form to 2
    end
  end
  if arg 2 is 1
    call ru_say_6e7885 arg 1
  end
  if arg 2 is 2
    call ru_say_83758d6e786c arg 1
  end
  if arg 2 is 3
    call ru_say_78646c6e7861 arg 1
  end
  if arg 2 is 4
    call ru_say_6f8d7895648d6e7861 arg 1
  end
  if arg 2 is 5
    call ru_say_999178a06e8578 arg 1
  end
  if arg 2 is 6
    call ru_say_798d6e78a06e8578 arg 1
  end
  if arg 2 is 7
    call ru_say_6e8d6da06e8578 arg 1
  end
  if arg 2 is 8
    call ru_say_75856e8d6da06e8578 arg 1
  end
  if arg 2 is 9
    call ru_say_838d759178a06e8578 arg 1
  end
  if arg 3 is 1
    if arg 4 is 0
      call ru_say_838d6e9178a0 arg 1
    end
    if arg 4 is 1
      call ru_say_85836c77776183656178a0 arg 1
    end
    if arg 4 is 2
      call ru_say_83758d776183656178a0 arg 1
    end
    if arg 4 is 3
      call ru_say_78646c776183656178a0 arg 1
    end
    if arg 4 is 4
      call ru_say_6f8d789564776183656178a0 arg 1
    end
    if arg 4 is 5
      call ru_say_999178776183656178a0 arg 1
    end
    if arg 4 is 6
      call ru_say_798d6e78776183656178a0 arg 1
    end
    if arg 4 is 7
      call ru_say_6e8d6d776183656178a0 arg 1
    end
    if arg 4 is 8
      call ru_say_75856e8d6d776183656178a0 arg 1
    end
    if arg 4 is 9
      call ru_say_838d759178776183656178a0 arg 1
    end
  else
    if arg 3 is 2
      call ru_say_83756183656178a0 arg 1
    end
    if arg 3 is 3
      call ru_say_78646c83656178a0 arg 1
    end
    if arg 3 is 4
      call ru_say_6e85648584 arg 1
    end
    if arg 3 is 5
      call ru_say_999178a0838d6e9178 arg 1
    end
    if arg 3 is 6
      call ru_say_798d6e78a0838d6e9178 arg 1
    end
    if arg 3 is 7
      call ru_say_6e8d6da0838d6e9178 arg 1
    end
    if arg 3 is 8
      call ru_say_75856e8d6da0838d6e9178 arg 1
    end
    if arg 3 is 9
      call ru_say_838d759177856e7885 arg 1
    end
    if arg 5 is 1
      if arg 4 is 1
        call ru_say_85837761 arg 1
      end
      if arg 4 is 2
        call ru_say_83758d arg 1
      end
    else
      if arg 4 is 1
        call ru_say_85836c77 arg 1
      end
      if arg 4 is 2
        call ru_say_837561 arg 1
      end
    end
    if arg 4 is 3
      call ru_say_78646c arg 1
    end
    if arg 4 is 4
      call ru_say_6f8d7895648d arg 1
    end
    if arg 4 is 5
      call ru_say_999178a0 arg 1
    end
    if arg 4 is 6
      call ru_say_798d6e78a0 arg 1
    end
    if arg 4 is 7
      call ru_say_6e8d6da0 arg 1
    end
    if arg 4 is 8
      call ru_say_75856e8d6da0 arg 1
    end
    if arg 4 is 9
      call ru_say_838d759178a0 arg 1
    end
  end
  if arg 5 is 1
    if form is 1
      call ru_say_78956e916f61 arg 1
    end
    if form is 2
      call ru_say_78956e916f6c arg 1
    end
    if form is 3
      call ru_say_78956e916f arg 1
    end
  end
  if arg 5 is 2
    if form is 1
      call ru_say_6d6c63636c8577 arg 1
    end
    if form is 2
      call ru_say_6d6c63636c857761 arg 1
    end
    if form is 3
      call ru_say_6d6c63636c85778575 arg 1
    end
  end
  if arg 5 is 3
    if form is 1
      call ru_say_6d6c63636c616483 arg 1
    end
    if form is 2
      call ru_say_6d6c63636c61648361 arg 1
    end
    if form is 3
      call ru_say_6d6c63636c6164838575 arg 1
    end
  end
  match
end

rule ru_digits_to_words takes 3 from ut_norm.obj
  afresh
  local p bytes 8
  local end bytes 8
  local n
  local k
  local form
  local ord
  local olen
  local q bytes 8
  local v
  local zero
  local d1
  local d2
  local d3
  local d4
  local d5
  local d6
  local d7
  local d8
  local d9
  local d10
  local d11
  local d12
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_r 1
  if answer is not 0
    go to english
  end
  set n to 0
  set d1 to 0
  set d2 to 0
  set d3 to 0
  set d4 to 0
  set d5 to 0
  set d6 to 0
  set d7 to 0
  set d8 to 0
  set d9 to 0
  set d10 to 0
  set d11 to 0
  set d12 to 0
  while 1
    set v to 10
    if v is 10
      call test_string_s 1 1 sym ru_d0
      if answer is 0
        set v to 0
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d1
      if answer is 0
        set v to 1
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d2
      if answer is 0
        set v to 2
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d3
      if answer is 0
        set v to 3
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d4
      if answer is 0
        set v to 4
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d5
      if answer is 0
        set v to 5
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d6
      if answer is 0
        set v to 6
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d7
      if answer is 0
        set v to 7
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d8
      if answer is 0
        set v to 8
      end
    end
    if v is 10
      call test_string_s 1 1 sym ru_d9
      if answer is 0
        set v to 9
      end
    end
    if v is 10
      leave
    end
    set d12 to d11
    set d11 to d10
    set d10 to d9
    set d9 to d8
    set d8 to d7
    set d7 to d6
    set d6 to d5
    set d5 to d4
    set d4 to d3
    set d3 to d2
    set d2 to d1
    set d1 to v
    increment n
  end
  if n is 0
    go to english
  end
  if n is more than 12
    go to english
  end
  # The end of the digits, walked to from the first of them a digit at a
  # time. It is not the caller's right point, which stands after the first
  # digit only, and not the place the scan stopped at, which at the end of
  # the text is nowhere.
  call lpta_loadp arg 1
  call setscan_r 1
  set k to n
  while k is more than 0
    call advance_tok
    decrement k
  end
  call savescptr 1 addr end
  call lpta_rpta_loadp arg 1 addr end
  call insert_2pt_s 1 1 sym ru_space 0
  # An ordinal: a hyphen and an ending straight after the digits, 1-го, 2-й,
  # 5-я. Everything but the last word is a cardinal and the last is the
  # ordinal, in the ending the text wrote; a round thousand is тысячный.
  set ord to 0
  set olen to 0
  call lpta_loadp addr end
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_hyphen
    if answer is 0
      call lpta_loadp addr end
      call setscan_r 1
      call advance_tok
      call savescptr 4 addr q
      if ord is 0
