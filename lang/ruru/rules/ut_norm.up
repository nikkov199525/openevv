  # A colon or a comma between two numbers is made a space, so that what
  # follows is a number of its own, and the comma is said: 3,5 is три запятая
  # пять and 19:45 is девятнадцать сорок пять. English's time and decimal
  # rules are left nothing to read.
  call lpta_loadp addr end
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_colon
    if answer is 0
