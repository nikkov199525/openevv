        call mark_s 1 4 0 0
      end
    end
  end
  call lpta_loadp addr end
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_comma
    if answer is 0
      call testFldeq 1 3 2
      if answer is 0
        call ru_say_62619991786191 addr end
        call lpta_loadp addr end
        call setscan_r 1
        call advance_tok
        call savescptr 2 addr p
        call lpta_rpta_loadp addr end addr p
        call mark_s 1 0 72 0
        call lpta_rpta_loadp addr end addr p
        call mark_s 1 1 0 0
        call lpta_rpta_loadp addr end addr p
        call mark_s 1 3 5 0
        call lpta_rpta_loadp addr end addr p
        call mark_s 1 4 0 0
      end
    end
  end
  match
place english
  call convert_eng_digits_to_words arg 1 arg 2
  if answer is 0
    match
  end
  give up
end
