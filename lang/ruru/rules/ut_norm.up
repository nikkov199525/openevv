# в, к and с are the three Russian prepositions with no vowel, and Russian
# says each as part of the word after it: в доме is one word stressed where
# доме is, and в парке is ф парке, since a consonant takes its voice from the
# one after it. A token of one letter is otherwise said by the letter's name.
# Joined to the next word before anything reads the token, the pair is an
# ordinary word and the letter rules do the rest.
#
# Only where a Russian word of two letters or more follows: буква в и буква с
# means the letters, and so does a в at the end of a sentence or before a
# number or an English word.
#
# The word after it is looked up in the dictionaries before the two are
# joined, since Russian's stress is in a dictionary and the joined word is in
# none. It stands where tok_lookup stood in normalize_text and hands over to
# it either way. The join is the machine's way of taking a character out: the
# letter and the space after it are one range, and the letter alone is laid
# back down over it.
rule ru_tok_lookup takes 2 from ut_norm.obj
  afresh
  local here bytes 8
  local right bytes 8
  local letter
  call ZZget_parmPTR addr here arg 1
  call ZZfence_null
  call ZZlpta_load__setscan_r__1 addr here
  if answer is not 0
    go to lookup
  end
  set letter to 0
  if letter is 0
    call test_string_s 1 1 sym ru_lt_75           # в
    if answer is 0
      set letter to sym ru_lt_75
    end
  end
  if letter is 0
    call test_string_s 1 1 sym ru_lt_84           # к
    if answer is 0
      set letter to sym ru_lt_84
    end
  end
  if letter is 0
    call test_string_s 1 1 sym ru_lt_6e           # с
    if answer is 0
      set letter to sym ru_lt_6e
    end
  end
  if letter is 0
    go to lookup
  end
  call test_string_s 1 1 sym ru_space           # a space after it
  if answer is not 0
    go to lookup
  end
  call savescptr 1 addr right
  while 1
    call test_string_s 1 1 sym ru_space         # and any more
    if answer is not 0
      leave
    end
    call savescptr 1 addr right
  end
  call ru_is_russian                            # then a Russian letter
  if answer is not 0
    go to lookup
  end
  call advance_tok
  if answer is not 0
    go to lookup
  end
  call ru_is_russian                            # and another
  if answer is not 0
    go to lookup
  end
  call tok_lookup addr right
  call lpta_rpta_loadp addr here addr right
  call insert_2pt_s 1 1 letter 0
place lookup
  call tok_lookup arg 1
  if answer is 0
    match
  end
  give up
end

# ---- Russian numbers ------------------------------------------------------
#
# English reads a number in English, and its number rules are thirteen
# thousand lines that know nothing of Russian. So a run of digits at the
# start of a token is written out as Russian words before any of them sees
# it: normalize_text asks ru_digits_to_words before it asks tok_lookup, where
# English's dates, times and money begin.
#
# English has one place where a run of digits becomes words, the language's
# convert_lang_digits_to_words, which every number comes to whatever else it
# is part of, and ru_digits_to_words stands where convert_eng_digits_to_words
# stood in it. The digits are read into twelve places, a space is laid over
# them, each word is laid over the space the text so far ends in with a
# space on either side of it, and the first space is taken out again.
#
# A number is said in groups of three: the hundreds, then a teen or the tens
# and the units, then the group's name -- тысяча, миллион, миллиард -- in the
# form its last two digits ask for. One and two are одна and две before
# тысяча. A number that begins with a nought is said a digit at a time, and
# one of more than twelve digits is left to English.
#
# One word laid down at the end of what has been said so far. The text
# before the point ends in a space, and the word goes over that space with
# one before it and one after, so it ends in a space again.
rule ru_say takes 4 from ut_norm.obj
  afresh
  local last bytes 8
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_l 1
  if answer is not 0
    give up
  end
  call advance_tok
  call savescptr 1 addr last
  call lpta_rpta_loadp addr last arg 1
  call insert_2pt_s 1 arg 3 arg 2 0
  match
end

# The words Russian counts with, one rule a word.
# восемнадцатая
rule ru_say_75856e8d6d7761836561786191 takes 2 from ut_norm.obj
  afresh
  call ru_say arg 1 sym ru_w_75856e8d6d7761836561786191 15
  match
end

