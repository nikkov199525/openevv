# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's English module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3b6ac
  place p3b6eb
  place p3b71e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b7bc
  end
  place p3b772
  call test_string_s 1 1 sym eti_s_1b9104
  if answer is not 0
    go to p3b7bc
  end
  place p3b78a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b7bc
  end
  place p3b7a0
  call test_string_s 1 1 sym eti_s_1b90d8
  if answer is 0
    match
  end
  place p3b7bc
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b81c
  end
  place p3b7d2
  call test_string_s 1 1 sym eti_s_1b911d
  if answer is not 0
    go to p3b81c
  end
  place p3b7ea
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b81c
  end
  place p3b800
  call test_string_s 1 1 sym eti_s_1b90d9
  if answer is 0
    match
  end
  place p3b81c
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p3b832
  call test_string_s 1 1 sym eti_s_1b911f
  if answer is not 0
    give up
  end
  place p3b84a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p3b860
  call test_string_s 1 1 sym eti_s_1b911e
  if answer is 0
    match
  end
  give up
end

