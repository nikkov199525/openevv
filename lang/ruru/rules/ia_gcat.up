end

# Whether the letters between the two points are one of the conjunctions Russian never stresses.
rule pol_unstressed_conj takes 3 from ia_gcat.obj
  afresh
  call ZZfence_null
  call lpta_loadp arg 1                 # и
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_fw_03
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # а
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_fw_01
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # но
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1504
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # да
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_0d01
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # ни
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1503
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  give up
end

# Whether the letters between the two points are one of the particles Russian never stresses,
# in the place Polish's się had.
rule pol_unstressed_pro takes 3 from ia_gcat.obj
  afresh
  call ZZfence_null
  call lpta_loadp arg 1                 # же
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_d602
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # бы
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_0b1e
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # ли
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1303
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  give up
end

# Whether the letters between the two points are any of the words above.
rule pol_never_stressed takes 3 from ia_gcat.obj
  afresh
  call pol_unstressed_prep arg 1 arg 2
  if answer is 0
    match
  end
  call pol_unstressed_conj arg 1 arg 2
  if answer is 0
    match
  end
  call pol_unstressed_pro arg 1 arg 2
  if answer is 0
    match
  end
  give up
end
