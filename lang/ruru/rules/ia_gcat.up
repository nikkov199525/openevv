# The words Russian never stresses: the prepositions -- на столе is
# на-сто-ле and до дома до-до-ма -- не, the conjunctions и, а, но, да and ни,
# and the particles же, бы and ли. Italian marks a word like that out of its
# function-word dictionary, with the stress level every such word has and a
# category, and that dictionary was emptied of Italian's words for Polish, so
# this asks the letters first, marks the word the way Italian's arms do -- the
# level in variable 1828, the category by name -- and otherwise hands over to
# Italian's rule, which finds nothing. The rules keep the names Polish gave
# them, which rules/it_strss.up and ut_norm.up call them by.
#
# The word must be the whole of the letters it is handed: на is not the start
# of наш. Categories are the word statement's: 3 adv, 17 prep, 8 conj,
# 18 pro.
#
# What is left of Polish's nie is never reached: its three letters are ние
# in Russian's bytes, which is no word.
rule pol_funct_words takes 5 from ia_gcat.obj
  afresh
  variable level word 1828
  local category
  call ZZfence_null
  call pol_unstressed_prep arg 1 arg 2
  if answer is 0
    set category to 17
    go to found
  end
  call pol_unstressed_conj arg 1 arg 2
  if answer is 0
    set category to 8
    go to found
  end
  call pol_unstressed_pro arg 1 arg 2
  if answer is 0
    set category to 18
    go to found
  end
  call lpta_loadp arg 1
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym pol_fw_nie
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        call pol_nie_keeps_stress arg 2
        if answer is not 0
          set category to 3
          go to found
        end
        go to others
      end
    end
  end
place others
  call ital_funct_words arg 1 arg 2 arg 3 arg 4
  if answer is 0
    match
  end
  give up
place found
  call lpta_rpta_loadp arg 3 arg 4
  call mark_v 4 3 addr level 0
  call lpta_rpta_loadp arg 3 arg 4
  call mark_s 4 1 category 0
  match
end

# Whether nie keeps its stress: it does when nothing follows but a pause, and
# when a word of one syllable follows that is not one of the words above and
# was not joined to it -- one written in capitals, say. Handed the point after
# the nie.
rule pol_nie_keeps_stress takes 2 from ia_gcat.obj
  afresh
  local next bytes 8
  local last bytes 8
  call lpta_loadp arg 1
  call setscan_r 1
  if answer is not 0
    match
  end
  call testFldeq 1 0 72
  if answer is not 0
    match
  end
  call advance_tok
  if answer is not 0
    match
  end
  call savescptr 1 addr next
  call pol_one_syllable addr next
  if answer is not 0
    give up
  end
  # Where that word ends, so that it can be held against the list whole.
  call lpta_loadp addr next
  call setscan_r 1
  while 1
    call pol_is_letter
    if answer is not 0
      leave
    end
    call advance_tok
    if answer is not 0
      leave
    end
  end
  call savescptr 2 addr last
  call pol_never_stressed addr next addr last
  if answer is 0
    give up
  end
  match
end

# Whether the word whose letters begin after this point has one syllable.
# A vowel letter is a syllable, but for one straight after an i, which is
# then the softness of the consonant before it: wiem and nie are one, piasek
# and kiedy two.
rule pol_one_syllable takes 2 from ia_gcat.obj
  afresh
  local count
  local afteri
  call lpta_loadp arg 1
  call setscan_r 1
  if answer is not 0
    give up
  end
  set count to 0
  set afteri to 0
  while 1
    call pol_is_vowel
    if answer is 0
      if afteri is 0
        increment count
      end
      set afteri to 0
      call testFldeq 1 0 3
      if answer is 0
        set afteri to 1
      end
    else
      call pol_is_letter
      if answer is not 0
        leave
      end
      set afteri to 0
    end
    call advance_tok
    if answer is not 0
      leave
    end
  end
  if count is 1
    match
  end
  give up
end

# Whether the next letter is a vowel. The codes are the bytes Russian's
# vowels took: а, я, е, э, и, о, у and ы where Polish had a, ą, e, ę, i, o, u
# and y, Polish's ó, which no Russian letter is, and ё and ю after them.
rule pol_is_vowel takes 1 from ia_gcat.obj
  bare
  afresh
  call testFldeq 1 0 1
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 207
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 2
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 209
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 3
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 4
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 110
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 5
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 30
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 100
  if answer is 0
    answer 0
  end
  call testFldeq 1 0 101
  if answer is 0
    answer 0
  end
  answer 1
end

# Whether the next thing is a letter of any kind, rather than a space, a
# mark or nothing at all.
rule pol_is_letter takes 1 from ia_gcat.obj
  bare
  afresh
  call testFldeq 1 4 1
  if answer is 0
    answer 0
  end
  call testFldeq 1 4 2
  if answer is 0
    answer 0
  end
  call testFldeq 1 4 3
  if answer is 0
    answer 0
  end
  call pol_is_vowel
end

# Whether the letters between the two points are one of the prepositions Russian never stresses, or не,
# which is unstressed as they are.
rule pol_unstressed_prep takes 3 from ia_gcat.obj
  afresh
  call ZZfence_null
  call lpta_loadp arg 1                 # на
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1501
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # до
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_0d04
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # по
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1604
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # от
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_041a
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # за
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1f01
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # о
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_fw_04
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # у
  call setscan_r 1
  if answer is 0
    call test_string_s 1 1 sym ru_fw_05
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # об
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_040b
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # ко
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1204
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # со
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1904
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # во
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1b04
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # из
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_031f
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # при
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym ru_fw_161803
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # про
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym ru_fw_161804
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # без
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym ru_fw_0b021f
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # для
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym ru_fw_0d13cf
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
