      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # обо
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym ru_fw_040b04
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
