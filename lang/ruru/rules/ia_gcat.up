  call lpta_loadp arg 1                 # изо
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym ru_fw_031f04
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # подо
  call setscan_r 1
  if answer is 0
    call test_string_s 1 4 sym ru_fw_16040d04
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # через
  call setscan_r 1
  if answer is 0
    call test_string_s 1 5 sym ru_fw_d00218021f
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # перед
  call setscan_r 1
  if answer is 0
    call test_string_s 1 5 sym ru_fw_160218020d
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 1                 # не
  call setscan_r 1
  if answer is 0
    call test_string_s 1 2 sym ru_fw_1502
    if answer is 0
      call lpta_loadp arg 2
      call test_ptr
      if answer is 0
