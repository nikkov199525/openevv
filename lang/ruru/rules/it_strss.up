# Where a Russian word is stressed, and what its unstressed vowels become.
#
# Russian stress is the word's own and no rule finds it, so this takes what
# the writing says and guesses the rest. In order:
#
#   the stress mark, the combining acute after a vowel, which a writer puts
#   where a word would be misread and a dictionary puts in every word it has;
#
#   ё, which is stressed wherever it stands, the first of them if there are
#   several;
#
#   a number word, each of which is listed whole with its syllable, since
#   the number rules write them after any dictionary has been asked;
#
#   the ending. An infinitive is stressed on the vowel before its ть and a
#   past tense on the one before its л, and -ист, -изм, -ант, -ент, -ок, -ец
#   and -ой carry the stress themselves, so those are stressed on the last
#   syllable. An adjective's ending of two vowels -- -ая, -ое, -ые, -ую --
#   and -ыми, -ого, -ому and their soft forms, and a noun's -ия and -ие,
#   leave it on the last vowel of the stem, which is two syllables before
#   the last;
#
#   and failing all of that the syllable before the last, which is the
#   commonest place.
#
# A vowel letter is a syllable in Russian, every one and nothing else, so the
# place is counted in letters and marked in syllables: the letters are walked
# from the start of the word, the vowels counted, and the count kept at a ё
# or a stress mark.
#
# It stands where Polish's pol_primary_stress stood, in assign_ital_stress.
rule ru_primary_stress takes 3 from it_strss.obj
  local left bytes 8
  local right bytes 8
  local count
  local vowels
  local target
  local togo
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  # How many syllables there are, by walking to the end of the word. The
  # scan starts outside the word, so this is one more than there are.
  call ZZlpta_load__setscan_r__7 addr left
  if answer is not 0
    give up
  end
  set count to 0
  while 1
    increment count
    call advance_tok
    if answer is not 0
      leave
    end
  end
  decrement count
  # The letters: which vowel, counted from one, the writing says.
  set vowels to 0
  set target to 0
  call lpta_loadp addr left
  call setscan_r 1
  if answer is 0
    while 1
      call pol_is_vowel
      if answer is 0
        increment vowels
        call testFldeq 1 0 100                   # ё
        if answer is 0
          if target is 0
            set target to vowels
          end
        end
      else
        call testFldeq 1 0 211                   # the stress mark
        if answer is 0
          set target to vowels
        else
          call pol_is_letter
          if answer is not 0
            leave
          end
        end
      end
      call advance_tok
      if answer is not 0
        leave
      end
    end
  end
  # A number word, and then the ending, where the writing says nothing.
  if target is 0
    call ru_word_first arg 1 arg 2
    if answer is 0
      set target to 1
    end
  end
  if target is 0
    call ru_word_second arg 1 arg 2
    if answer is 0
      set target to 2
    end
  end
  if target is 0
    call ru_word_third arg 1 arg 2
    if answer is 0
      set target to 3
    end
  end
  if target is 0
    call ru_word_last arg 1 arg 2
    if answer is 0
      set target to count
    end
  end

  if target is 0
    set target to count
    decrement target
    call ru_ends_stressed arg 2
    if answer is 0
      set target to count
    else
      call ru_ends_stem_stressed arg 2
      if answer is 0
        decrement target
      end
    end
  end
  if target is more than count
    set target to count
  end
  if target is less than 1
    set target to 1
  end
  # And the mark, over the syllable that many in: what it covers begins
  # after its left end.
  call ZZlpta_load__setscan_r__7 addr left
  if answer is not 0
    give up
  end
  set togo to target
  decrement togo
  while togo is more than 0
    call advance_tok
    decrement togo
  end
  call savescptr 1 addr left
  call advance_tok
  if answer is 0
    call savescptr 2 addr right
    call ZZlprp_load__insert_2pt_i_7_2_ZZstring3 addr left addr right
    call ru_reduce arg 1 arg 2
    match
  end
  give up
end

# What an unstressed vowel becomes. Russian says its о as а wherever the
# stress is not, its е as и, and its я as и too when a consonant stands before
# it and the word goes on after it: молоко is малако, река рика, пятно
# питно, and время keeps the а it ends in.
#
# It walks the phones of the word once the stress is marked, asks of each о,
# е and а which syllable it is in and whether that one is stressed, and lays
# the other vowel down in its place. An а is only я's when the letter that
# begins where it does is я, which is so after a consonant and not after the
# glide.
rule ru_reduce takes 3 from it_strss.obj
  afresh
  local pl bytes 8
  local pr bytes 8
  local kind
  local final
  call ZZfence_null
  call lpta_loadp arg 1
  call setscan_r 2
  if answer is not 0
    give up
  end
  while 1
    call savescptr 1 addr pl
    set kind to 0
    call testFldeq 2 0 33                      # о
    if answer is 0
      set kind to 1
    end
    call testFldeq 2 0 29                      # е
    if answer is 0
      set kind to 2
    end
    call testFldeq 2 0 30                      # а
    if answer is 0
      set kind to 3
    end
    call advance_tok
    if answer is not 0
      leave
    end
    call savescptr 2 addr pr
    set final to 0
    call lpta_loadp arg 2
    call test_ptr
    if answer is 0
      set final to 1
    end
    if kind is 3
      # Only я's а, and not the one a word ends in.
      set kind to 0
      if final is 0
        call lpta_loadp addr pl
        call setscan_r 1
        if answer is 0
          call testFldeq 1 0 207
          if answer is 0
            set kind to 3
          end
        end
      end
    end
    if kind is not 0
      call lpta_loadp addr pl
      call lpta_tstctxtl 7
      if answer is 0
        call setscan_r 7
        if answer is 0
          call testFldeq 7 0 0
          if answer is 0
            call lpta_rpta_loadp addr pl addr pr
            if kind is 1
              call insert_2pt_s 2 1 sym ru_ph_a 0
            else
              call insert_2pt_s 2 1 sym ru_ph_i 0
            end
          end
        end
      end
    end
    if final is not 0
      leave
    end
    # Back to the phones, after this one: asking about the letters and the
    # syllables moved the scan off them.
    call lpta_loadp addr pr
    call setscan_r 2
    if answer is not 0
      leave
    end
  end
  match
end

# Whether the word that ends at this point ends in one of the endings stressed on the last syllable.
# The letters are read leftwards from the end, nearest first, so each
