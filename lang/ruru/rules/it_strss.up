# Whether the word between the two points is one of the number words
# stressed on the first syllable. Read leftwards from its end, and then
# asked whether that was the whole of it.
rule ru_word_first takes 3 from it_strss.obj
  afresh
  call ZZfence_null
  call lpta_loadp arg 2                 # тысяча
  call setscan_l 1
  if answer is 0
    call test_string_s 1 6 sym ru_end_1a1e19cfd001
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # тысячи
  call setscan_l 1
  if answer is 0
    call test_string_s 1 6 sym ru_end_1a1e19cfd003
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # десять
  call setscan_l 1
  if answer is 0
    call test_string_s 1 6 sym ru_end_0d0219cf1ad2
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # девять
  call setscan_l 1
  if answer is 0
    call test_string_s 1 6 sym ru_end_0d021bcf1ad2
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # восемь
  call setscan_l 1
  if answer is 0
    call test_string_s 1 6 sym ru_end_1b04190214d2
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # семьдесят
  call setscan_l 1
  if answer is 0
    call test_string_s 1 9 sym ru_end_190214d20d0219cf1a
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # восемьдесят
  call setscan_l 1
  if answer is 0
    call test_string_s 1 11 sym ru_end_1b04190214d20d0219cf1a
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # двацать
  call setscan_l 1
  if answer is 0
    call test_string_s 1 7 sym ru_end_0d1b010c011ad2
    if answer is 0
      call lpta_loadp arg 1
      call test_ptr
      if answer is 0
        match
      end
    end
  end
  call lpta_loadp arg 2                 # трицать
