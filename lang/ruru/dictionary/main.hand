# Written by hand, and copied onto the end of main.dic as it stands by
# tools/module/stresswords.py. Abbreviations Russian writes with a dot, said
# in full; the dot stays where it was, so it is read as it would be after
# the full word.
руб	рубле́й
коп	копе́ек
